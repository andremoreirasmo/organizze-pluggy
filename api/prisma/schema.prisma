generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Setting {
  id        String   @id @default("default")
  data      Json
  updatedAt DateTime @updatedAt
}

model PluggyItem {
  id                    String   @id @default(cuid())
  itemId                String   @unique
  /// Optional label set by the user (overrides institution/connector name in UI)
  customName            String?
  connectorId           Int?
  connectorName         String?
  connectorImageUrl     String?
  connectorPrimaryColor String?
  connectorType         String?
  /// Real bank inferred from accounts when connector is MeuPluggy
  institutionName       String?
  institutionImageUrl   String?
  institutionPrimaryColor String?
  institutionCompeCode  String?
  status                String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model ReviewDecision {
  id                  String             @id @default(cuid())
  pluggyTransactionId String             @unique
  providerId          String?
  decision            ReviewDecisionType
  notes               String?
  /// Snapshot of the Pluggy tx at ignore/link time (for ignored list UX)
  snapshot            Json?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

enum ReviewDecisionType {
  IGNORED
  LINKED
  IMPORTED
  INVOICE_PAYMENT
}

model AuthSession {
  id                  String   @id @default(cuid())
  tokenHash           String   @unique
  email               String
  createdAt           DateTime @default(now())
  lastSeenAt          DateTime @default(now())
  absoluteExpiresAt   DateTime

  @@index([email])
}

enum CustomRecurringKind {
  EXPENSE
  INCOME
}

enum CustomRecurringUnit {
  DAY
  WEEK
  MONTH
}

enum CustomRecurringStatus {
  ACTIVE
  CANCELLED
}

enum CustomRecurringOccurrenceStatus {
  PENDING
  CREATED
  FAILED
}

/// App-owned recurrence (Organizze only gets normal one-off transactions).
model CustomRecurringSeries {
  id            String                @id @default(cuid())
  kind          CustomRecurringKind
  description   String
  amountCents   Int
  accountId     Int
  categoryId    Int?
  tags          Json
  startDate     DateTime              @db.Date
  endDate       DateTime              @db.Date
  intervalUnit  CustomRecurringUnit
  intervalCount Int
  status        CustomRecurringStatus @default(ACTIVE)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  occurrences   CustomRecurringOccurrence[]
}

model CustomRecurringOccurrence {
  id                     String                          @id @default(cuid())
  seriesId               String
  index                  Int
  scheduledDate          DateTime                        @db.Date
  amountCents            Int
  /// Organizze ids exceed Postgres INT32 (e.g. 3_258_676_510).
  organizzeTransactionId BigInt?
  status                 CustomRecurringOccurrenceStatus @default(PENDING)
  lastError              String?
  series                 CustomRecurringSeries           @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([seriesId, index])
  @@index([seriesId])
}

enum SavingsGoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
}

enum GoalLedgerKind {
  CONTRIBUTION
  REALLOCATION
  ADJUSTMENT
}

/// User prefs for %-of-income savings targets (single row).
model GoalsPreference {
  id                      String   @id @default("default")
  minPct                  Float    @default(30)
  primaryPct              Float    @default(35)
  idealPct                Float    @default(40)
  /// Category ids treated as investment contributions (not consumption).
  investmentCategoryIds   Json     @default("[]")
  estimatedUsdBrl         Float?
  updatedAt               DateTime @updatedAt
}

model SavingsGoal {
  id                         String            @id @default(cuid())
  name                       String
  targetCents                Int
  allocatedCents             Int               @default(0)
  targetDate                 DateTime?         @db.Date
  priority                   Int               @default(100)
  monthlyContributionCents   Int?
  monthlyContributionPct     Float?
  status                     SavingsGoalStatus @default(ACTIVE)
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  ledger                     GoalLedgerEntry[]

  @@index([status, priority])
}

model GoalLedgerEntry {
  id          String         @id @default(cuid())
  goalId      String
  date        DateTime       @db.Date
  amountCents Int
  kind        GoalLedgerKind
  note        String?
  createdAt   DateTime       @default(now())
  goal        SavingsGoal    @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, date])
}
