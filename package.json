{
  "name": "organizze-pluggy",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm --prefix api run start:dev",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build && npm --prefix api run build",
    "start": "npm --prefix api run start:prod",
    "prisma:generate": "npm --prefix api exec prisma generate",
    "prisma:migrate": "npm --prefix api exec prisma migrate dev",
    "pluggy:refresh": "node scripts/meu-pluggy-refresh.mjs",
    "pluggy:refresh:login": "node scripts/meu-pluggy-refresh.mjs --headed",
    "pluggy:refresh:export": "node scripts/meu-pluggy-refresh.mjs --headed --export-state-only",
    "pluggy:refresh:install": "node scripts/install-playwright-chromium.mjs"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.17.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "playwright": "^1.56.1"
  }
}
