# Google Sign-In (OIDC) — create an OAuth 2.0 Client ID (Web) in Google Cloud Console
# Authorized JavaScript origins: http://localhost:5173 (dev) and your Cloud Run URL (prod)
GOOGLE_CLIENT_ID=
# Comma-separated allowlist of Google accounts that may use the app
GOOGLE_ALLOWED_EMAILS=you@gmail.com
# HMAC secret for the session cookie (min 32 chars)
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32

# Server
PORT=3000
NODE_ENV=development

# Organizze API (https://app.organizze.com.br/configuracoes/api-keys)
ORGANIZZE_EMAIL=you@email.com
ORGANIZZE_API_TOKEN=
ORGANIZZE_USER_AGENT=organizze-pluggy (you@email.com)

# Pluggy (https://dashboard.pluggy.ai)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Neon Postgres (pooled connection string) — required to store bank connections
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
